{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "esModuleInterop": true, "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "types": ["node"], "noEmit": true
  },
  "include": ["server/**/*.ts", "lib/**/*.ts", "adapters/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
