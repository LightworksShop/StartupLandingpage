# Add these values to the existing root .env or the server's secret store.
# Do not commit real credentials. The public website also works without this setup.
MARKETING_DATABASE_URL=postgresql://smartwerk:CHANGE_ME@127.0.0.1:5432/smartwerk_marketing
# Local Docker setup (npm run setup:local populates these in the root .env):
MARKETING_DB_PORT=55432
MARKETING_DB_PASSWORD=
MARKETING_PUBLIC_URL=http://localhost:3000
MARKETING_ADMIN_USER=
# Generate via npm run admin:password (password through stdin).
MARKETING_ADMIN_PASSWORD_HASH=
# At least 32 random characters, stable across server restarts.
MARKETING_SESSION_SECRET=
# Exactly 32 random bytes in base64; stable, backed up, server-side only.
MARKETING_CREDENTIALS_KEY=
# Optional absolute directory. Default: marketing/var/media. Persist and back up.
MARKETING_MEDIA_DIR=
# Additional trusted HTTPS origins for remotely stored media; comma-separated.
MARKETING_MEDIA_ORIGINS=
MARKETING_AGENT_TOKEN=
MARKETING_PUBLISH_ENABLED=false
MARKETING_FEEDS_ENABLED=false

MARKETING_LINKEDIN_CLIENT_ID=
MARKETING_LINKEDIN_CLIENT_SECRET=
# Verified against the official 202608 docs on 2026-10-20. Recheck during onboarding.
MARKETING_LINKEDIN_API_VERSION=202608
# both = profile + company-page permissions; person or organization for narrower apps.
MARKETING_LINKEDIN_AUTHOR_TYPE=both
# Required only in organization-only mode. Both mode discovers approved pages.
MARKETING_LINKEDIN_ORGANIZATION_URN=
# Optional, only scopes actually granted to the app, e.g. r_member_social.
# w_member_social alone does not allow versioned Images API status reads.
MARKETING_LINKEDIN_EXTRA_SCOPES=

# Optional Instagram and Pinterest adapters retained from the export.
MARKETING_INSTAGRAM_LOGIN_METHOD=instagram
MARKETING_INSTAGRAM_CLIENT_ID=
MARKETING_INSTAGRAM_CLIENT_SECRET=
MARKETING_META_API_VERSION=
MARKETING_PINTEREST_CLIENT_ID=
MARKETING_PINTEREST_CLIENT_SECRET=

# Set in the ROOT environment for a deployment behind exactly one trusted proxy:
# TRUST_PROXY_HOPS=1
# HOST=0.0.0.0
